// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id             String          @id @default(cuid())
  externalId     String          @unique
  name           String
  storage        String          @default("")
  sessions       Session[]
  booths         Booth[]
  otherItems     OtherItem[]
  tracks         Track[]
  rooms          Room[]
  mediaLocations MediaLocation[]
  activityLogs   ActivityLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Room {
  id         String    @id @default(cuid())
  externalId Int
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  name       String
  sessions   Session[]

  @@unique([eventId, externalId])
}

model Track {
  id         String    @id @default(cuid())
  externalId Int
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id])
  name       String
  color      String?
  itemOrder  Int?
  sessions   Session[]

  @@unique([eventId, externalId])
}

model Session {
  id             String          @id @default(cuid())
  externalId     Int
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id])
  roomId         String?
  room           Room?           @relation(fields: [roomId], references: [id])
  trackId        String?
  track          Track?          @relation(fields: [trackId], references: [id])
  name           String
  date           DateTime
  startTime      String
  endTime        String
  sessionType    String?
  sessionTypeId  Int?
  status         SessionStatus   @default(AVAILABLE)
  isActive       Boolean         @default(true)
  isManual       Boolean         @default(false)
  lastSyncedAt   DateTime        @default(now())
  mediaLocations MediaLocation[]

  @@unique([eventId, externalId])
  @@index([eventId, date])
}

model Booth {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id])
  name           String
  mediaLocations MediaLocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([eventId])
}

model OtherItem {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id])
  name           String
  description    String?
  date           DateTime
  time           String
  mediaLocations MediaLocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([eventId])
}

model MediaLocation {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  sessionId   String?
  session     Session?   @relation(fields: [sessionId], references: [id])
  boothId     String?
  booth       Booth?     @relation(fields: [boothId], references: [id])
  otherItemId String?
  otherItem   OtherItem? @relation(fields: [otherItemId], references: [id])
  folderPath  String
  mediaType   MediaType
  description String?
  notes       String?
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([eventId])
  @@index([sessionId])
  @@index([boothId])
  @@index([otherItemId])
}

model ActivityLog {
  id         String         @id @default(cuid())
  eventId    String
  event      Event          @relation(fields: [eventId], references: [id])
  action     ActivityAction
  message    String
  entityType String?
  entityId   String?
  createdAt  DateTime       @default(now())

  @@index([eventId, createdAt])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  SYNC
}

enum MediaType {
  PHOTO
  VIDEO
  MIXED
  OTHER
}

enum SessionStatus {
  AVAILABLE
  CANCELLED
}
